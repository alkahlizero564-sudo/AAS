import 'package:flutter/material.dart';

class AppTemplate {
  final String id;
  final String title;
  final String subtitle;
  final IconData icon;
  final Map<String, dynamic> spec;
  AppTemplate(this.id, this.title, this.subtitle, this.icon, this.spec);
}

Map<String, dynamic> _app(
  String name,
  String role,
  String desc,
  List<String> screens,
  List<String> features,
) =>
    {
      'name': name,
      'role': role,
      'description': desc,
      'screens': screens,
      'features': features,
      'design': 'عصري وفخم: خلفية كحلية داكنة مع لون ليموني مميز وبطاقات دائرية كبيرة',
    };

Map<String, dynamic> _spec(
  Map<String, dynamic> customer,
  Map<String, dynamic> admin,
  List<String> tables,
  List<String> notifications,
) =>
    {
      'apps': [customer, admin],
      'backend': {
        'tables': tables,
        'roles': [
          'customer: يرى ويعدل بياناته فقط',
          'staff: يدير الطلبات والحجوزات',
          'admin: صلاحيات كاملة وتقارير',
        ],
        'notifications': notifications,
        'auth': 'البريد الإلكتروني + رمز تأكيد (OTP)',
      },
    };

